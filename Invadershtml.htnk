                        <!DOCTYPE html>
                        <html lang="en">
                        <head>
                            <meta charset="UTF-8">
                            <meta name="viewport" content="width=device-width, initial-scale=1.0">
							<style>
								body {
									background-color: white; /* Ensure the iframe has a white background */
								}

								
							</style>
                        </head>
                        <body>
                            <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Retro Space Invaders (1978)</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #050505;
      color: #fff;
      font-family: 'Courier New', Courier, monospace;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
      user-select: none;
    }
    #cabinet {
      position: relative;
      border: 4px solid #222;
      border-radius: 12px;
      background: #000;
      box-shadow: 0 0 40px rgba(0, 255, 65, 0.15), inset 0 0 10px rgba(0, 0, 0, 0.8);
      padding: 10px;
    }
    canvas {
      display: block;
      background-color: #000;
      image-rendering: pixelated;
    }
    /* CRT Scanline Overlay */
    #cabinet::after {
      content: " ";
      position: absolute;
      top: 10px; left: 10px; right: 10px; bottom: 10px;
      pointer-events: none;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
      background-size: 100% 4px;
      border-radius: 4px;
    }
    .instructions {
      margin-top: 12px;
      font-size: 13px;
      color: #888;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-align: center;
    }
    .instructions span {
      color: #0f0;
    }
  </style>
</head>
<body>

<div id="cabinet">
  <canvas id="gameCanvas" width="600" height="700"></canvas>
</div>
<div class="instructions">
  <span>[A / D]</span> or <span>[← / →]</span> Move &nbsp;|&nbsp; 
  <span>[SPACE]</span> Fire / Start &nbsp;|&nbsp; 
  <span>[M]</span> Audio Mute
</div>

<script>
(() => {
  // --- SOUND SYNTHESIZER (Web Audio API) ---
  class SoundFX {
    constructor() {
      this.ctx = null;
      this.muted = false;
      this.tempoStep = 0;
      this.tempoFreqs = [174.61, 164.81, 155.56, 146.83]; // Classic 4-note march
    }
    init() {
      if (!this.ctx) {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        this.ctx = new AudioContext();
      }
    }
    playTone(freq, duration, type = "square", endFreq = null) {
      if (this.muted || !this.ctx) return;
      try {
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
        if (endFreq !== null) {
          osc.frequency.exponentialRampToValueAtTime(Math.max(1, endFreq), this.ctx.currentTime + duration);
        }
        gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + duration);
      } catch (e) {}
    }
    playNoise(duration) {
      if (this.muted || !this.ctx) return;
      try {
        const bufferSize = this.ctx.sampleRate * duration;
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
        const noise = this.ctx.createBufferSource();
        noise.buffer = buffer;
        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + duration);
        noise.connect(gain);
        gain.connect(this.ctx.destination);
        noise.start();
      } catch (e) {}
    }
    shoot() { this.playTone(900, 0.15, "triangle", 200); }
    alienBoom() { this.playNoise(0.2); }
    playerBoom() { this.playNoise(0.55); }
    alienStep() {
      this.playTone(this.tempoFreqs[this.tempoStep], 0.08, "square");
      this.tempoStep = (this.tempoStep + 1) % this.tempoFreqs.length;
    }
  }

  // --- BITMAP SPRITE MATRICES ---
  const SPRITES = {
    squid: [
      [ // Frame 0
        "00011000",
        "00111100",
        "01111110",
        "11011011",
        "11111111",
        "00100100",
        "01011010",
        "10100101"
      ],
      [ // Frame 1
        "00011000",
        "00111100",
        "01111110",
        "11011011",
        "11111111",
        "01000010",
        "10011001",
        "01000010"
      ]
    ],
    crab: [
      [
        "00100000100",
        "00010001000",
        "00111111100",
        "01101110110",
        "11111111111",
        "10111111101",
        "10100000101",
        "00011011000"
      ],
      [
        "00100000100",
        "10010001001",
        "10111111101",
        "11101110111",
        "11111111111",
        "00111111100",
        "00100000100",
        "01000000010"
      ]
    ],
    octopus: [
      [
        "000011110000",
        "011111111110",
        "111111111111",
        "111001100111",
        "111111111111",
        "000110011000",
        "001101101100",
        "110000000011"
      ],
      [
        "000011110000",
        "011111111110",
        "111111111111",
        "111001100111",
        "111111111111",
        "001100110000",
        "011001100110",
        "001100001100"
      ]
    ],
    player: [
      "00000100000",
      "00001110000",
      "00001110000",
      "01111111110",
      "11111111111",
      "11111111111",
      "11111111111",
      "11111111111"
    ],
    ufo: [
      "0000011111100000",
      "0001111111111000",
      "0011111111111100",
      "0110110110110110",
      "1111111111111111",
      "0001110001110000",
      "0000100000100000"
    ]
  };

  // --- GAME CONFIG & CONSTANTS ---
  const CANVAS = document.getElementById("gameCanvas");
  const CTX = CANVAS.getContext("2d");
  const WIDTH = CANVAS.width;
  const HEIGHT = CANVAS.height;

  const SFX = new SoundFX();
  const KEYS = {};

  const GAME_STATE = {
    START: 0,
    PLAYING: 1,
    PLAYER_HIT: 2,
    GAME_OVER: 3,
    VICTORY: 4
  };

  let currentState = GAME_STATE.START;
  let score = 0;
  let highScore = 0;
  let lives = 3;
  let wave = 1;
  let deathTimer = 0;

  // --- ENTITIES ---
  const player = {
    x: WIDTH / 2 - 16,
    y: HEIGHT - 64,
    w: 33,
    h: 24,
    speed: 4.5,
    bullet: null
  };

  let aliens = [];
  let alienBullets = [];
  let bunkers = [];
  let ufo = null;
  let ufoTimer = 0;
  let particles = [];

  // Swarm dynamics
  let alienDir = 1;
  let alienStepTimer = 0;
  let alienStepInterval = 50;
  let alienFrame = 0;

  // --- HELPER: SPRITE RENDERER ---
  function drawPixelMatrix(matrix, x, y, pixelSize, color) {
    CTX.fillStyle = color;
    for (let r = 0; r < matrix.length; r++) {
      for (let c = 0; c < matrix[r].length; c++) {
        if (matrix[r][c] === '1') {
          CTX.fillRect(x + c * pixelSize, y + r * pixelSize, pixelSize, pixelSize);
        }
      }
    }
  }

  // --- BUNKER GENERATOR ---
  function createBunkers() {
    bunkers = [];
    const count = 4;
    const bunkerW = 54;
    const bunkerH = 40;
    const spacing = (WIDTH - (count * bunkerW)) / (count + 1);
    const pixelSize = 3;

    // Pattern: 18 wide x 13 tall cells
    const shape = [
      "000111111111111000",
      "001111111111111100",
      "011111111111111110",
      "111111111111111111",
      "111111111111111111",
      "111111111111111111",
      "111111111111111111",
      "111111111111111111",
      "111111000000111111",
      "111110000000011111",
      "111100000000001111",
      "111100000000001111",
      "111100000000001111"
    ];

    for (let i = 0; i < count; i++) {
      const bx = spacing + i * (bunkerW + spacing);
      const by = HEIGHT - 145;
      const cells = [];

      for (let r = 0; r < shape.length; r++) {
        for (let c = 0; c < shape[r].length; c++) {
          if (shape[r][c] === '1') {
            cells.push({
              x: bx + c * pixelSize,
              y: by + r * pixelSize,
              w: pixelSize,
              h: pixelSize,
              alive: true
            });
          }
        }
      }
      bunkers.push(cells);
    }
  }

  // --- ALIEN GENERATOR ---
  function initAliens() {
    aliens = [];
    alienBullets = [];
    alienDir = 1;
    alienStepInterval = Math.max(8, 52 - (wave - 1) * 5);
    alienStepTimer = alienStepInterval;

    const rows = 5;
    const cols = 11;
    const startX = 60;
    const startY = 110 + Math.min(60, (wave - 1) * 15);

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        let type = 'octopus';
        let pts = 10;
        let color = '#25ff43';
        let pxSize = 2.5;

        if (r === 0) {
          type = 'squid';
          pts = 30;
          color = '#38e1ff';
          pxSize = 3;
        } else if (r === 1 || r === 2) {
          type = 'crab';
          pts = 20;
          color = '#e342ff';
          pxSize = 2.8;
        }

        aliens.push({
          x: startX + c * 42,
          y: startY + r * 34,
          w: 30,
          h: 22,
          type: type,
          pts: pts,
          color: color,
          pxSize: pxSize,
          row: r,
          col: c
        });
      }
    }
  }

  function resetGame() {
    score = 0;
    lives = 3;
    wave = 1;
    player.x = WIDTH / 2 - 16;
    player.bullet = null;
    particles = [];
    ufo = null;
    ufoTimer = 0;
    initAliens();
    createBunkers();
  }

  function startNextWave() {
    wave++;
    player.bullet = null;
    alienBullets = [];
    ufo = null;
    initAliens();
  }

  // --- INPUT LISTENERS ---
  window.addEventListener("keydown", (e) => {
    SFX.init();
    if (["Space", "ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(e.code)) {
      e.preventDefault();
    }
    KEYS[e.code] = true;

    if (e.code === "KeyM") {
      SFX.muted = !SFX.muted;
    }

    if (e.code === "Space") {
      if (currentState === GAME_STATE.START || currentState === GAME_STATE.GAME_OVER || currentState === GAME_STATE.VICTORY) {
        resetGame();
        currentState = GAME_STATE.PLAYING;
      } else if (currentState === GAME_STATE.PLAYING && !player.bullet) {
        player.bullet = {
          x: player.x + player.w / 2 - 1.5,
          y: player.y - 6,
          w: 3,
          h: 12,
          speed: 8.5
        };
        SFX.shoot();
      }
    }
  });

  window.addEventListener("keyup", (e) => {
    KEYS[e.code] = false;
  });

  // --- COLLISION HELPER ---
  function rectIntersect(r1, r2) {
    return !(
      r2.x > r1.x + r1.w ||
      r2.x + r2.w < r1.x ||
      r2.y > r1.y + r1.h ||
      r2.y + r2.h < r1.y
    );
  }

  function explodeAt(x, y, color, count = 12) {
    for (let i = 0; i < count; i++) {
      particles.push({
        x: x,
        y: y,
        vx: (Math.random() - 0.5) * 6,
        vy: (Math.random() - 0.5) * 6,
        life: 18 + Math.random() * 8,
        color: color
      });
    }
  }

  // --- UPDATE LOGIC ---
  function update() {
    // Particles update
    for (let i = particles.length - 1; i >= 0; i--) {
      let p = particles[i];
      p.x += p.vx;
      p.y += p.vy;
      p.life--;
      if (p.life <= 0) particles.splice(i, 1);
    }

    if (currentState === GAME_STATE.PLAYER_HIT) {
      deathTimer--;
      if (deathTimer <= 0) {
        if (lives <= 0) {
          currentState = GAME_STATE.GAME_OVER;
        } else {
          player.x = WIDTH / 2 - 16;
          player.bullet = null;
          alienBullets = [];
          currentState = GAME_STATE.PLAYING;
        }
      }
      return;
    }

    if (currentState !== GAME_STATE.PLAYING) return;

    // 1. Player Movement
    if (KEYS["ArrowLeft"] || KEYS["KeyA"]) {
      player.x = Math.max(16, player.x - player.speed);
    }
    if (KEYS["ArrowRight"] || KEYS["KeyD"]) {
      player.x = Math.min(WIDTH - player.w - 16, player.x + player.speed);
    }

    // 2. Player Laser Motion & Bunker/Alien Collision
    if (player.bullet) {
      player.bullet.y -= player.bullet.speed;

      // Alien Hit Check
      for (let i = aliens.length - 1; i >= 0; i--) {
        const al = aliens[i];
        if (rectIntersect(player.bullet, al)) {
          explodeAt(al.x + al.w / 2, al.y + al.h / 2, al.color, 16);
          SFX.alienBoom();
          score += al.pts;
          if (score > highScore) highScore = score;
          aliens.splice(i, 1);
          player.bullet = null;

          // Adapt march interval as alien counts decrease
          alienStepInterval = Math.max(3, Math.floor((aliens.length / 55) * 45));
          break;
        }
      }

      // Bunker Hit Check
      if (player.bullet) {
        bunkerLoop:
        for (let b = 0; b < bunkers.length; b++) {
          const cells = bunkers[b];
          for (let c = 0; c < cells.length; c++) {
            const cell = cells[c];
            if (cell.alive && rectIntersect(player.bullet, cell)) {
              cell.alive = false;
              // Splash damage to neighboring bunker tiles
              cells.forEach(adj => {
                if (adj.alive && Math.hypot(adj.x - cell.x, adj.y - cell.y) < 7) {
                  adj.alive = false;
                }
              });
              player.bullet = null;
              break bunkerLoop;
            }
          }
        }
      }

      // Top ceiling bounds
      if (player.bullet && player.bullet.y < 55) {
        explodeAt(player.bullet.x, player.bullet.y, '#fff', 4);
        player.bullet = null;
      }
    }

    // 3. Swarm Step Timing & Movement
    alienStepTimer--;
    if (alienStepTimer <= 0) {
      alienStepTimer = alienStepInterval;
      alienFrame = alienFrame === 0 ? 1 : 0;
      SFX.alienStep();

      let hitWall = false;
      for (let i = 0; i < aliens.length; i++) {
        if ((alienDir === 1 && aliens[i].x + aliens[i].w >= WIDTH - 20) ||
            (alienDir === -1 && aliens[i].x <= 20)) {
          hitWall = true;
          break;
        }
      }

      if (hitWall) {
        alienDir *= -1;
        for (let i = 0; i < aliens.length; i++) {
          aliens[i].y += 18;
          // Alien reaches defense perimeter / ground
          if (aliens[i].y + aliens[i].h >= player.y) {
            lives = 0;
            currentState = GAME_STATE.GAME_OVER;
            SFX.playerBoom();
            return;
          }
        }
      } else {
        for (let i = 0; i < aliens.length; i++) {
          aliens[i].x += alienDir * 10;
        }
      }
    }

    // 4. Invader Bombs
    // Fire probability based on living invader count
    if (aliens.length > 0 && Math.random() < 0.035 && alienBullets.length < 3) {
      // Pick columns that have living bottom-most aliens
      const validShooters = [];
      for (let c = 0; c < 11; c++) {
        const colAliens = aliens.filter(a => a.col === c);
        if (colAliens.length > 0) {
          colAliens.sort((a, b) => b.y - a.y);
          validShooters.push(colAliens[0]);
        }
      }
      if (validShooters.length > 0) {
        const shooter = validShooters[Math.floor(Math.random() * validShooters.length)];
        alienBullets.push({
          x: shooter.x + shooter.w / 2 - 1.5,
          y: shooter.y + shooter.h + 2,
          w: 3,
          h: 10,
          speed: 4.2
        });
      }
    }

    // Update alien bombs
    for (let i = alienBullets.length - 1; i >= 0; i--) {
      const b = alienBullets[i];
      b.y += b.speed;

      // Hit Player?
      if (rectIntersect(b, player)) {
        alienBullets.splice(i, 1);
        explodeAt(player.x + player.w / 2, player.y + player.h / 2, '#00ff41', 25);
        SFX.playerBoom();
        lives--;
        currentState = GAME_STATE.PLAYER_HIT;
        deathTimer = 60;
        return;
      }

      // Hit Bunkers?
      for (let k = 0; k < bunkers.length; k++) {
        const cells = bunkers[k];
        for (let c = 0; c < cells.length; c++) {
          const cell = cells[c];
          if (cell.alive && rectIntersect(b, cell)) {
            cell.alive = false;
            cells.forEach(adj => {
              if (adj.alive && Math.hypot(adj.x - cell.x, adj.y - cell.y) < 7) {
                adj.alive = false;
              }
            });
            alienBullets.splice(i, 1);
            break;
          }
        }
      }

      // Out of screen bottom
      if (b.y > HEIGHT - 20) {
        alienBullets.splice(i, 1);
      }
    }

    // Invader Eating Bunker Tiles
    for (let i = 0; i < aliens.length; i++) {
      const al = aliens[i];
      for (let b = 0; b < bunkers.length; b++) {
        const cells = bunkers[b];
        for (let c = 0; c < cells.length; c++) {
          if (cells[c].alive && rectIntersect(al, cells[c])) {
            cells[c].alive = false;
          }
        }
      }
    }

    // 5. Mystery UFO
    ufoTimer++;
    if (!ufo && ufoTimer > 850 && Math.random() < 0.005) {
      const direction = Math.random() > 0.5 ? 1 : -1;
      ufo = {
        x: direction === 1 ? -45 : WIDTH + 10,
        y: 65,
        w: 42,
        h: 18,
        dir: direction,
        speed: 2.2
      };
      ufoTimer = 0;
    }

    if (ufo) {
      ufo.x += ufo.dir * ufo.speed;
      if (player.bullet && rectIntersect(player.bullet, ufo)) {
        const ufoPts = [50, 100, 150, 300][Math.floor(Math.random() * 4)];
        score += ufoPts;
        if (score > highScore) highScore = score;
        explodeAt(ufo.x + ufo.w / 2, ufo.y + ufo.h / 2, '#ff1a1a', 20);
        SFX.alienBoom();
        ufo = null;
        player.bullet = null;
      } else if ((ufo.dir === 1 && ufo.x > WIDTH + 50) || (ufo.dir === -1 && ufo.x < -50)) {
        ufo = null;
      }
    }

    // 6. Round Win Check
    if (aliens.length === 0) {
      startNextWave();
    }
  }

  // --- RENDER LOGIC ---
  function render() {
    CTX.fillStyle = "#000";
    CTX.fillRect(0, 0, WIDTH, HEIGHT);

    // Render HUD (Score, High Score)
    CTX.font = "18px 'Courier New', monospace";
    CTX.fillStyle = "#ffffff";
    CTX.fillText(`SCORE: ${String(score).padStart(4, '0')}`, 24, 34);
    CTX.fillStyle = "#ff2222";
    CTX.fillText(`HI-SCORE: ${String(highScore).padStart(4, '0')}`, WIDTH - 200, 34);

    // Decorative top border
    CTX.strokeStyle = "#333";
    CTX.lineWidth = 2;
    CTX.beginPath();
    CTX.moveTo(10, 46);
    CTX.lineTo(WIDTH - 10, 46);
    CTX.stroke();

    // 1. Render Bunkers
    for (let b = 0; b < bunkers.length; b++) {
      const cells = bunkers[b];
      CTX.fillStyle = "#25ff43";
      for (let i = 0; i < cells.length; i++) {
        if (cells[i].alive) {
          CTX.fillRect(cells[i].x, cells[i].y, cells[i].w, cells[i].h);
        }
      }
    }

    // 2. Render Aliens
    for (let i = 0; i < aliens.length; i++) {
      const al = aliens[i];
      const spriteData = SPRITES[al.type][alienFrame];
      drawPixelMatrix(spriteData, al.x, al.y, al.pxSize, al.color);
    }

    // 3. Render UFO
    if (ufo) {
      drawPixelMatrix(SPRITES.ufo, ufo.x, ufo.y, 2.5, '#ff2525');
    }

    // 4. Render Player
    if (currentState !== GAME_STATE.PLAYER_HIT || Math.floor(deathTimer / 4) % 2 === 0) {
      drawPixelMatrix(SPRITES.player, player.x, player.y, 3, "#25ff43");
    }

    // 5. Render Player Laser
    if (player.bullet) {
      CTX.fillStyle = "#ffffff";
      CTX.fillRect(player.bullet.x, player.bullet.y, player.bullet.w, player.bullet.h);
    }

    // 6. Render Alien Bombs
    CTX.fillStyle = "#fffc38";
    for (let i = 0; i < alienBullets.length; i++) {
      const b = alienBullets[i];
      // Classic zig-zag style bomb
      CTX.fillRect(b.x + (Math.sin(b.y * 0.4) * 2), b.y, b.w, b.h);
    }

    // 7. Render Explosions / Debris
    for (let i = 0; i < particles.length; i++) {
      const p = particles[i];
      CTX.fillStyle = p.color;
      CTX.fillRect(p.x, p.y, 2.5, 2.5);
    }

    // 8. Ground Line
    CTX.strokeStyle = "#25ff43";
    CTX.lineWidth = 2;
    CTX.beginPath();
    CTX.moveTo(10, HEIGHT - 30);
    CTX.lineTo(WIDTH - 10, HEIGHT - 30);
    CTX.stroke();

    // 9. Bottom HUD (Lives & Wave)
    CTX.fillStyle = "#ffffff";
    CTX.font = "16px 'Courier New', monospace";
    CTX.fillText(`LIVES:`, 24, HEIGHT - 10);
    for (let i = 0; i < lives; i++) {
      drawPixelMatrix(SPRITES.player, 90 + i * 32, HEIGHT - 22, 1.8, "#25ff43");
    }
    CTX.fillText(`WAVE: ${wave}`, WIDTH - 110, HEIGHT - 10);

    // OVERLAY SCREENS
    if (currentState === GAME_STATE.START) {
      CTX.fillStyle = "rgba(0,0,0,0.85)";
      CTX.fillRect(0, 0, WIDTH, HEIGHT);

      CTX.textAlign = "center";
      CTX.fillStyle = "#25ff43";
      CTX.font = "30px 'Courier New', monospace";
      CTX.fillText("SPACE INVADERS", WIDTH / 2, HEIGHT / 2 - 100);

      CTX.font = "16px 'Courier New', monospace";
      CTX.fillStyle = "#ffffff";
      CTX.fillText("* SCORE ADVANCE TABLE *", WIDTH / 2, HEIGHT / 2 - 40);

      drawPixelMatrix(SPRITES.ufo, WIDTH / 2 - 50, HEIGHT / 2 - 15, 2, "#ff2525");
      CTX.fillStyle = "#ff2525";
      CTX.fillText("= ? MYSTERY", WIDTH / 2 + 35, HEIGHT / 2);

      drawPixelMatrix(SPRITES.squid[0], WIDTH / 2 - 45, HEIGHT / 2 + 20, 2.2, "#38e1ff");
      CTX.fillStyle = "#38e1ff";
      CTX.fillText("= 30 POINTS", WIDTH / 2 + 35, HEIGHT / 2 + 35);

      drawPixelMatrix(SPRITES.crab[0], WIDTH / 2 - 47, HEIGHT / 2 + 55, 2, "#e342ff");
      CTX.fillStyle = "#e342ff";
      CTX.fillText("= 20 POINTS", WIDTH / 2 + 35, HEIGHT / 2 + 70);

      drawPixelMatrix(SPRITES.octopus[0], WIDTH / 2 - 48, HEIGHT / 2 + 90, 1.8, "#25ff43");
      CTX.fillStyle = "#25ff43";
      CTX.fillText("= 10 POINTS", WIDTH / 2 + 35, HEIGHT / 2 + 105);

      CTX.fillStyle = "#ffff38";
      CTX.font = "18px 'Courier New', monospace";
      CTX.fillText("PRESS [SPACE] TO PLAY", WIDTH / 2, HEIGHT / 2 + 170);
      CTX.textAlign = "start";
    } else if (currentState === GAME_STATE.GAME_OVER) {
      CTX.fillStyle = "rgba(0,0,0,0.85)";
      CTX.fillRect(0, 0, WIDTH, HEIGHT);

      CTX.textAlign = "center";
      CTX.fillStyle = "#ff2525";
      CTX.font = "36px 'Courier New', monospace";
      CTX.fillText("GAME OVER", WIDTH / 2, HEIGHT / 2 - 30);

      CTX.fillStyle = "#fff";
      CTX.font = "18px 'Courier New', monospace";
      CTX.fillText(`FINAL SCORE: ${score}`, WIDTH / 2, HEIGHT / 2 + 15);

      CTX.fillStyle = "#25ff43";
      CTX.fillText("PRESS [SPACE] TO RESTART", WIDTH / 2, HEIGHT / 2 + 65);
      CTX.textAlign = "start";
    }
  }

  // --- MAIN LOOP ---
  function loop() {
    update();
    render();
    requestAnimationFrame(loop);
  }

  // Run on startup
  resetGame();
  currentState = GAME_STATE.START;
  requestAnimationFrame(loop);
})();
</script>
</body>
</html>

